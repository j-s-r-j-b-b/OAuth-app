# Copy this file to .env and fill in the values. .env is git-ignored.

# --- LLM (any OpenAI-compatible endpoint; defaults to Google Gemini's free tier) ---
# Get a free key (no card) at https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite

# --- Composio (free Hobby plan) ---
# Used for web search + page fetch (Composio Search toolkit) and toolkit auth details.
# Get it at https://dashboard.composio.dev -> Project settings -> API keys
COMPOSIO_API_KEY=

# --- Server ---
PORT=8787
# Where generated guides are stored. On Railway, mount a volume here.
DATA_DIR=./.data
