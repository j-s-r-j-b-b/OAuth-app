{
  "name": "oauth-runway",
  "version": "0.1.0",
  "private": true,
  "description": "Guides for getting a provider OAuth app created, approved, and wired into Composio — with a live research agent for any app.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "catalog": "tsx scripts/fetch-catalog.ts",
    "validate": "tsx scripts/validate-guides.ts",
    "generate": "tsx scripts/generate.ts",
    "typecheck": "tsc --noEmit",
    "replay": "tsx scripts/replay-probes.ts",
    "report": "tsx scripts/report.ts",
    "smoke": "tsx scripts/smoke-live.ts",
    "live-eval": "tsx scripts/live-eval.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "marked": "^18.1.2",
    "openai": "^7.45.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
